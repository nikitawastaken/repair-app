# Шаблон production-конфигурации.
# Скопируйте в .env.prod и подставьте реальные значения.
# ВАЖНО: .env.prod добавлен в .gitignore и НЕ должен попадать в репозиторий.
# SECRET_KEY генерируется автоматически скриптом scripts/prod/init.sh,
# если оставить значение-плейсхолдер ниже.

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/repairdb
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=repairdb
VITE_API_URL=http://localhost:8000
APP_ENV=production
